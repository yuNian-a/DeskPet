#!/usr/bin/env python3
"""Start Hermes Display daemon on Windows from WSL. Non-blocking, safe for TUI."""
import subprocess, socket, time, sys, os

PORT = 19876

def is_running():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.5)
        s.connect(("127.0.0.1", PORT))
        s.close()
        return True
    except Exception:
        return False

if is_running():
    sys.exit(0)

# close_fds=True: prevent powershell from stealing Hermes TUI stdin
subprocess.Popen(
    ['powershell.exe', '-Command',
     r"& 'D:\Anaconda3\python.exe' 'D:\workspace\hermes display\display\display.py'"],
    start_new_session=True,
    stdin=subprocess.DEVNULL,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
    close_fds=True,
)

for _ in range(15):
    time.sleep(0.2)
    if is_running():
        print("[display] Ready", flush=True)
        sys.exit(0)
print("[display] Started (port check timeout)", flush=True)
sys.exit(0)  # Don't block Hermes even if port check fails
